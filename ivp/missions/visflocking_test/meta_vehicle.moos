//-------------------------------------------------
// FILE: meta_vehicle.moos
//-------------------------------------------------
ServerHost   = localhost
ServerPort   = $(VPORT)
Community    = $(VNAME)
MOOSTimeWarp = $(WARP)

LatOrigin  = 47.696170
LongOrigin = 9.195229

ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200
  Run = MOOSDB           @ NewConsole = false
  Run = uSimMarineV23    @ NewConsole = false
  Run = pMarinePIDV22    @ NewConsole = false
  Run = pHelmIvP         @ NewConsole = false
  Run = pNodeReporter    @ NewConsole = false
  Run = pShare           @ NewConsole = false
  Run = uFldNodeBroker   @ NewConsole = false
}

ProcessConfig = pShare
{
  AppTick    = 2
  CommsTick  = 2
  Input = route=127.0.0.1:$(SHARE_LISTEN)
}

ProcessConfig = uFldNodeBroker
{
  AppTick   = 1
  CommsTick = 1
  TRY_SHORE_HOST = pshare_route=127.0.0.1:$(SHORE_LISTEN)
  BRIDGE = src=NODE_REPORT_LOCAL,  alias=NODE_REPORT
  BRIDGE = src=NODE_MESSAGE_LOCAL, alias=NODE_MESSAGE
}

ProcessConfig = pHelmIvP
{
  AppTick    = 4
  CommsTick  = 4
  ivp_behavior_dir = /home/mneu/PROJECT/moos-ivp/lib
  behaviors  = targ_$(VNAME).bhv
  domain     = course:0:359:360
  domain     = speed:0:4:41
}

ProcessConfig = uSimMarineV23
{
  AppTick   = 4
  CommsTick = 4
  start_pos = $(START_POS)
  prefix    = NAV
  turn_rate = 95
  thrust_map = 0:0, 50:2, 100:4
}

ProcessConfig = pMarinePIDV22
{
  AppTick    = 20
  CommsTick  = 20
  yaw_pid_kp = 0.9
  yaw_pid_kd = 0.3
  yaw_pid_ki = 0.3
  speed_factor = 20
}

ProcessConfig = pNodeReporter
{
  AppTick    = 2
  CommsTick  = 2
  platform_type = boat
  platform_color = yellow
}