//------------------------------------------
// pEchoVar config block
ProcessConfig = pEchoVar
{
  AppTick   = 4
  CommsTick = 4

  // Duplicate the variable to bypass pShare's echo-filter
  Echo = NODE_REPORT -> NODE_REPORT_ALL
}

//------------------------------------------
// uNodeReportAggregator config block
ProcessConfig = uNodeReportAggregator
{
  AppTick   = 4
  CommsTick = 4

  target_vehicle_count = 10
  vname_prefix = sim
  out_var_name = NODE_REPORTS_AGG
}

//------------------------------------------
// uTimerScript config block -- draws the torus boundary in pMarineViewer.
// uSimMarineV23 already posts VIEW_POLYGON for each wormhole's own entry
// bands (WormHoleSet::addWormHoleConfig), but deliberately styles them
// invisible (edge/vertex color "invisible", fill "white" at 10%
// transparency -- see WormHoleSet.cpp) so they don't clutter a real
// mission's display. This posts one clearly-colored square outline at the
// actual wrap boundary (+/-82 on each axis, matching meta_vehicle.moos's
// wormhole placement) once at startup, purely for visual verification.
ProcessConfig = uTimerScript
{
  AppTick   = 4
  CommsTick = 4

  paused    = false
  reset_max = 0
  reset_time = end

  event = time=0.1, var=VIEW_POLYGON, val="pts={-82,-82:82,-82:82,82:-82,82},edge_color=red,vertex_color=red,edge_size=3,vertex_size=5,label=torus_boundary,label_color=white"
}

//------------------------------------------
// pFlockEvaluator config block (ported from visflocking_optimize) --
// logs a running-average PolarizationOrder/MeanDistance/MaxClusterSize/
// AreaToCircleRatio/OverlapRatio row to flock_evaluation.csv on every tick,
// so you can watch flocking metrics update live (e.g. via `uXMS` or by
// tailing the CSV) while observing the run in pMarineViewer.
ProcessConfig = pFlockEvaluator
{
  AppTick   = 4
  CommsTick = 4

  RUN_ID = $(RUN_ID)

  // Kept explicit at the old library default rather than switching to the
  // AGENT_DIAMETER-derived 2*radius overlap threshold -- this sim mission's
  // "boats" aren't modeled at real physical scale, so an explicit
  // OVERLAP_DISTANCE still wins over AGENT_DIAMETER here (see
  // FlockEvaluator.h's m_overlap_distance_explicit).
  OVERLAP_DISTANCE = 0.9

  // MaxClusterSize now uses Ward hierarchical clustering on a composite
  // position+heading distance (see FlockEvaluator::computeLargestCluster),
  // cut at CLUSTER_THRESHOLD (0.275 is ABM's tuned default; kept here since
  // the metric is normalized by the arena diagonal and thus scale-invariant).
  CLUSTER_THRESHOLD = 0.275

  // This mission wraps ownship across a 164m (2x82) torus via
  // uSimMarineV23 wormholes (see meta_vehicle.moos) -- without these,
  // MeanDistance/MaxClusterSize/OverlapRatio/AreaToCircleRatio all use
  // plain unwrapped Euclidean distance and spike/break for any pair
  // straddling a wormhole seam. ARENA_WIDTH must match the wormhole
  // spacing's full period (82*2), not the 82 half-width itself.
  // ARENA_WIDTH/ARENA_HEIGHT also set the arena-diagonal normalization used
  // by CLUSTER_THRESHOLD's distance metric, independent of TOROIDAL.
  TOROIDAL = true
  ARENA_WIDTH = 164.0
  ARENA_HEIGHT = 164.0
}
