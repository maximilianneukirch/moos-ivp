//----------------------------------------------
// Behavior File für Alice

initialize   DEPLOY = false
initialize   RETURN = false

//----------------------------------------------
// Unser neues Visual Swarm Behavior

Behavior = BHV_VisFlocking
{
  // Allgemeiner Name und Priorität
  name      = vision_swarm_alice
  pwt       = 100
  condition = DEPLOY = true
  condition = RETURN = false

  // Parameter, die wir in setParam() definiert haben
  vpf_variable = VISION_PROJECTION_FIELD
  fov          = 175.0
  resolution   = 320
  
  // Die mathematischen Parameter aus dem Paper
  a0 = 1.25  // Beschleunigungskraft
  a1 = 1.25  // Front/Back Gleichgewichtsdistanz (repulsion)
  b0 = 1.75  // Rotationskraft
  b1 = 1.75  // Left/Right Gleichgewichtsdistanz (repulsion)
}

//----------------------------------------------
// (Optional) Ein Return-Behavior für das Ende der Mission
Behavior = BHV_Waypoint
{
  name       = waypt_return
  pwt        = 100
  condition  = RETURN = true
  condition  = DEPLOY = true
  endflag    = RETURN = false
  endflag    = DEPLOY = false

  speed      = 2.0
  radius     = 2.0
  nm_radius  = 8.0
  point      = 0,0
}