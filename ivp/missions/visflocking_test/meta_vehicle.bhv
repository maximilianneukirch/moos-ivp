Behavior = BHV_AvoidCollisionSail
{
  name         = ac_
  //pwt          = 200
  condition    = DEPLOY = true
  updates      = COLLISION_CONTACT
  templating   = spawn

  contact   = to-be-set
  on_no_contact_ok = true
  extrapolate  = true
  decay        = 30,60

  // 2. ENGAGEMENT RANGES (Required for your scale)
  pwt_outer_dist = 4.0
  pwt_inner_dist = 3.5

  // 3. CPA DISTANCES
  min_util_cpa_dist = 3.5
  max_util_cpa_dist = 4.0
  //completed_dist = 2
  pwt_grade = linear
  bearing_line_config = white:0, green:0.65, yellow:0.8, red:1.0
}

