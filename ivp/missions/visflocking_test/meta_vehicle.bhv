Behavior = BHV_SoftBoundary
{
  // General Behavior parameters
  // ---------------------------

  name = soft_boundary
  pwt = 70
  updates = VIEW_POINT

  // Params specific to this behavior
  // --------------------------------
  max_range = 20.0
  min_range = 10.0
  peak_width = 5.0
  polygon = pts={-25,50:29,50:29,-50:-25,-50}
  min_speed = 1.0
}

