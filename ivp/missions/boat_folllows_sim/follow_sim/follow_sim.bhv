//-------------------------------------------------
FILE: onboard/follow_sim.bhv
//-------------------------------------------------

initialize   DEPLOY = false
initialize   RETURN = false
	
//----------------------------------------------
Behavior = BHV_Waypoint
{ 
  name      = follow_sim
  pwt       = 100
  condition = DEPLOY = true
  condition = RETURN = false
  
  // Dynamically change the target point (e.g.: WPT_UPDATE = "points=50,100" or "points=50,100 # speed=3.5")
  updates   = WPT_UPDATE
  
  // Keeps the behavior active and waiting for the next update
  perpetual = true

  speed_alt = 1.2
  use_alt_speed = true
  lead = 8
  lead_damper = 1
  lead_to_start = true
  capture_line = true
  capture_radius = 5.0
  slip_radius = 15.0
  
  // Default speed if not overridden by the update
  speed = 2.0   

  // Start with a safe dummy point (0,0) so the helm has something to parse on boot
  polygon = 0,0 

  order = normal
  repeat  = 0
}

//----------------------------------------------
// Optional: A safety return behavior in case the XBee link dies
Behavior=BHV_Waypoint
{
  name      = safety
  pwt       = 100
  condition = RETURN = true
  condition = DEPLOY = true
  perpetual = true
  
  speed = 2.0
  capture_radius = 2.0
  slip_radius = 8.0
  
  // The home base coordinate
  points = 0,-20
}