//-------------------------------------------------
// NAME: Maximilian v. Neukirch
// FILE: meta_vehicle.bhv
//-------------------------------------------------

initialize   DEPLOY = false
initialize   RETURN = false

//----------------------------------------------
// Pureley vision-based flocking behavior from Mezey et. al.

Behavior = BHV_VisFlocking
{
  name      = vision_swarm_$(VNAME)
  pwt       = 100
  condition = DEPLOY = true
  condition = RETURN = false

  // Shore pShare strips the suffix, so this is just VPF
  vpf_variable = VPF

  // Must match pSimVisionServer's fov in meta_shoreside.moos -- the VPF
  // array is only meaningful to VisionModel if both agree on how many
  // degrees it spans (see launch.sh, which plugs the same FOV_VAL into
  // both files).
  fov          = $(FOV_VAL)

  a0 = $(A0_VAL)  // social acceleration strength
  a1 = $(A1_VAL)  // equilibrium speed
  b0 = $(B0_VAL)  // social turning strength
  b1 = $(B1_VAL)  // equilibrium psi

  v0 = 1.0
  gam = $(GAM_VAL)

  // Default is 2.5s. Raised after finding that low-to-moderate b0 (0-1)
  // barely moved PolarizationOrder/MeanDistance at all in a fixed-a0 sweep,
  // while b0=2-4 changed them a lot -- a much later "onset" than the paper's
  // own heatmaps. Investigation (see chat/commit history) ruled out
  // pMarinePIDV22: it tracks DESIRED_HEADING tightly (checked live via
  // uXMS) even for the larger swings turn_lookahead=6.0 now commands, no
  // oscillation. The raw model signal (dpsi, temporarily exposed as
  // DEBUG_DPSI in BHV_VisFlocking.cpp) also already scales close to
  // linearly with b0. The actual bottleneck was this constant: with a0=0
  // (no cohesion), a brief visual encounter with a weak b0 only nudges the
  // target heading by a few degrees before contact is lost and the target
  // freezes (see the all_zero_vpf branch) -- too small a course change to
  // show up in the flock's spatial statistics over one run. A larger
  // lookahead makes even a brief, weak encounter commit to a bigger,
  // longer-lasting heading change, which is what actually moved the needle
  // in a re-test (b0=0.25 already visibly different from b0=0, vs needing
  // b0>=2 before). Retune if you change run duration/MOOSTimeWarp/turn_rate.
  turn_lookahead = 6.0
}

