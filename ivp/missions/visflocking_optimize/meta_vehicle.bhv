//-------------------------------------------------
// NAME: Maximilian v. Neukirch
// FILE: meta_vehicle.bhv
//-------------------------------------------------

initialize   DEPLOY = false
initialize   RETURN = false

//----------------------------------------------
// Pureley vision-based flocking behavior from Mezey et. al.

Behavior = BHV_VisFlocking
{
  name      = vision_swarm_$(VNAME)
  pwt       = 100
  condition = DEPLOY = true
  condition = RETURN = false

  // Shore pShare strips the suffix, so this is just VPF
  vpf_variable = VPF

  // Must match pSimVisionServer's fov in meta_shoreside.moos -- the VPF
  // array is only meaningful to VisionModel if both agree on how many
  // degrees it spans (see launch.sh, which plugs the same FOV_VAL into
  // both files).
  fov          = $(FOV_VAL)

  a0 = $(A0_VAL)  // social acceleration strength
  a1 = $(A1_VAL)  // equilibrium speed
  b0 = $(B0_VAL)  // social turning strength
  b1 = $(B1_VAL)  // equilibrium psi

  // 0.3 m/s, with time_scale = 3 below: together they put one model timestep
  // at 1/3 s and one step of travel at 0.1 m = 0.18 agent radii, which is the
  // paper's v0 = 1 px/ts with 5.5 px agents. (v0 = 1 m/s with time_scale = 10
  // has the same dimensionless physics on paper, but it runs the model at 10
  // timesteps per second -- faster than the MOOS pipeline can deliver a fresh
  // visual field, and a perception lag of a few timesteps destroys the
  // flocking state in the paper's own model too.)
  v0 = 0.3
  gam = $(GAM_VAL)

  // Model time base. The paper's model is written in simulation timesteps
  // (v0 = 1 px/ts; gam, a0, b0 are rates per timestep), so the behavior needs
  // to know how many timesteps pass per second. One px is R_A/5.5 = 0.1 m for
  // this mission's 0.55 m agent radius, and a boat at v0 = 1 m/s covers that
  // in 0.1 s -> 1 timestep = 0.1 s -> 10 timesteps per second. a0/b0/gam below
  // therefore stay at the paper's literal values and the heatmap axes remain
  // directly comparable with Supp. Fig. 3.
  //
  // (This replaces the old turn_lookahead kludge. That parameter existed
  // because low b0 barely moved the flock statistics -- which was this missing
  // time-base conversion, compounded by an under-geared speed loop and a hull
  // that could only turn at ~2 deg/s; see meta_vehicle.moos's speed_factor and
  // yaw_pid_kp comments. The behavior now integrates dpsi into its own heading
  // state instead of nudging a target relative to the hull's heading.)
  time_scale = 3.0

  // Angular masks. The paper prints cos/sin (Eqs. 4-7), but its own simulator
  // runs sigmoid (boxcar-like) masks on the code path used for the published
  // sweeps -- ABM vf_supcalc.VSWRM_flocking_state_variables' non-verbose
  // branch, which vf_agent always takes (verbose_supcalc = False), hardcodes
  // cos_sigmoid/sin_sigmoid at steepness 3*pi. Same symmetry, but a neighbour
  // off to the side or behind keeps full weight instead of being tapered to
  // zero at +/-90 deg. Set "trig" to run the published equations instead.
  mask_shape = sigmoid

  // Anti-windup off (it pinned desired speed to NAV_SPEED + 1 regardless of
  // a0); heading guard on, as a diagnostic backstop if the hull can't keep up.
  max_speed_error = 0.0
  max_heading_error = 60.0
}

