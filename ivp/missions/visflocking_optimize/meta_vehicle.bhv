//----------------------------------------------
// Wind Maneuverability behavior

Behavior = BHV_WindManeuverability
{
  name = wind_maneuverability
  pwt = 100
  condition = DEPLOY = true

  //polar_plot = $(POLAR_PLOT)

  // No-go handling/tack stability
  nogo_speed_frac = 0.15
  nogo_penalty = -1000
  hysteresis_deg = 30
  hysteresis_bonus = 10
}



//----------------------------------------------
// Retrun behavior (Return to homepoint)

Behavior = BHV_Waypoint
{
  name      = waypt_return
  pwt       = 100
  condition = RETURN = true
  condition = DEPLOY = true
  perpetual = true
  updates   = RETURN_UPDATE
  endflag   = RETURN = false
  endflag   = DEPLOY = false
  endflag   = MISSION = complete

  speed = 2.0
  capture_radius = 2.0
  slip_radius = 8.0

  // MACRO FOR RETURN POSITION
  points = $(RETURN_POS)
}

//----------------------------------------------
//Backup bahavior (drive straight)

Behavior = BHV_ConstantSpeed
{
  name      = const_speed
  pwt       = 100
  condition = SPD=true
  condition = DEPLOY = true
  perpetual = true
  updates   = SPEED_UPDATE
  endflag   = SPD = false

  speed = 0.5
  duration = 10
  duration_reset = CONST_SPD_RESET=true
}
