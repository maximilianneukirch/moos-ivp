//-------------------------------------------------
// FILE: shoreside.moos
//-------------------------------------------------
ServerHost   = localhost
ServerPort   = $(SHORE_PORT)
Community    = shoreside
MOOSTimeWarp = 10  // must match meta_vehicle.moos -- see the note there

// Lake of Constance
LatOrigin   = 47.695803
LongOrigin  = 9.194176

//------------------------------------------
// Antler configuration  block

ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200
  Run = MOOSDB          @ NewConsole = false
  // Run = pMarineViewer   @ NewConsole = false
  Run = pShare          @ NewConsole = false

  Run = pSimVisionServer @ NewConsole = false
  Run = pEchoVar        @ NewConsole = false
  Run = uTimerScript    @ NewConsole = false
  Run = uFlockEvaluator @ NewConsole = false

// Verification/trajectory logging, off by default (LOGGING=yes ./launch.sh ...).
// The shoreside DB sees every vehicle's NODE_REPORT, so this one log covers
// the whole fleet and is what plot_trajectories.py reads. Left off for sweeps,
// where 144 runs x 10 boats of alog is pure I/O.
#ifdef LOGGING yes
  Run = pLogger         @ NewConsole = false
#endif
}

//------------------------------------------
// pLogger config block (only launched when LOGGING=yes)

ProcessConfig = pLogger
{
  AppTick   = 4
  CommsTick = 4

  AsyncLog = true
  PATH = ./
  FILETIMESTAMP = true

  Log = NODE_REPORT @ 0 NOSYNC
  Log = DEPLOY_ALL @ 0 NOSYNC
  // The synthesized visual fields, logged next to the very NODE_REPORTs they
  // were built from -- lets a VPF be checked against its own input geometry
  // with no transport asymmetry in between.
  Log = VPF_ALPHA_001 @ 0 NOSYNC
  Log = VPF_ALPHA_002 @ 0 NOSYNC
}

//------------------------------------------
// pShare config block
// Routes DEPLOY and RETURN to all simulated vehicles

ProcessConfig = pShare
{
  // 20 Hz, not 4: this is the path the visual field travels (vehicle pShare ->
  // shoreside pEchoVar -> pSimVisionServer -> shoreside pShare -> vehicle), and
  // every hop quantizes it. At the mission's time_scale one model timestep is
  // 0.1 s, so a 4 Hz hop is 2.5 timesteps of staleness and the full path was
  // ~5 timesteps -- at which point the flocking state does not survive (the
  // paper's own model, re-run with 5 timesteps of perception lag, drops from
  // P = 0.85 to P = 0.39, which is exactly what this mission was producing).
  AppTick    = 20
  CommsTick  = 20

  Input = route = localhost:$(SHORE_PSHARE_PORT)

  // This config part will be dynamically generated by launch.sh
  #include plug_pshare_outputs.moos
}

//------------------------------------------
// pMarineViewer config block

ProcessConfig = pMarineViewer
{
  AppTick    = 4
  CommsTick  = 12

  scope = VIEW_POLYGON

  tiff_file            = Satellite_Lake_of_Constance.tif
  tiff_file            = Map_Lake_of_Constance.tif

  set_pan_x            = -90
  set_pan_y            = -280
  zoom                 = 0.65
  vehicle_shape_scale  = 1.5
  hash_delta           = 50
  hash_shade           = 0.22
  hash_viewable        = true

  trails_point_size    = 5

  // Appcast configuration
  appcast_height       = 75
  appcast_width        = 30
  appcast_viewable     = true
  appcast_color_scheme = indigo
  nodes_font_size      = xlarge
  procs_font_size      = xlarge
  appcast_font_size    = large

  // Variable scope
  scope = MOOS_MANUAL_OVERRIDE
  scope = MOOS_MANUAL_OVERRIDE_ALL

  button_one = DEPLOY # DEPLOY_ALL=true # RETURN_ALL=false # MOOS_MANUAL_OVERRIDE_ALL=false
  button_two = RETURN # RETURN_ALL=true
  button_three = FASTER # WPT_UPDATE=speed=3.5

  action  = MENU_KEY=deploy # DEPLOY = true # RETURN = false
  action+ = MENU_KEY=deploy # MOOS_MANUAL_OVERRIDE=false # MOOS_MANUAL_OVERRIDE_ALL=false
  action  = RETURN=true
  action  = UPDATES_RETURN=speed=1.4
}

//------------------------------------------
// pSimVisionServer config block

ProcessConfig = pSimVisionServer
{
  // 20 Hz: 2 ticks per model timestep, so the VPF is never more than half a
  // timestep old (see the pShare note above).
  AppTick   = 20
  CommsTick = 20

  // Must match BHV_VisFlocking's fov in meta_vehicle.bhv -- see the note
  // there. Plugged in by launch.sh together with the vehicle .bhv files.
  fov         = $(FOV_VAL)

  // Retina resolution, scaled with the FOV by launch.sh so that the angular
  // resolution stays 1.125 deg/bin (= 360/320, Supp. Table 1's Nret = 320
  // over a full circle) in every FOV column. This matters because the
  // minimum-blob-width rule -- a target narrower than one bin is invisible,
  // exactly as in the paper's ABM -- is what sets the vision range:
  // R_A/tan(half a bin) = 0.55/tan(0.5625deg) = 56m = 102 agent radii, the
  // same 0.62 x arena the paper has. A fixed 320 across a shrinking FOV
  // would have silently given the 25% FOV column 4x the vision range.
  resolution  = $(RES_VAL)
  boat_length = 1.1
  boat_beam   = 1.1

  // Torus: bearings/ranges must use the minimum-image displacement, or a
  // neighbour that has wrapped is rendered on the far side of the arena in
  // the wrong direction. Must match meta_vehicle.moos's wormhole period.
  toroidal     = true
  arena_width  = 90.2
  arena_height = 90.2

  real_boat_prefix = real
}

