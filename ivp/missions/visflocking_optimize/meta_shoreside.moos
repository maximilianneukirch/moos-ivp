//------------------------------------------
// pEchoVar config block
ProcessConfig = pEchoVar
{
  AppTick   = 4
  CommsTick = 4

  // Instantly duplicate the variable to bypass pShare's echo-filter
  Echo = NODE_REPORT -> NODE_REPORT_ALL
}

//------------------------------------------
// uTimerScript config block

ProcessConfig = uTimerScript
{
  AppTick   = 4
  CommsTick = 4

  // Das Skript startet sofort aktiv und ist nicht pausiert
  paused    = false

  // Das Skript wird nach dem Ausführen beendet und nicht wiederholt
  reset_max  = 0
  reset_time = end

  // uFlockEvaluator now subscribes to this same DEPLOY_ALL post and gates
  // all metric accumulation/logging on it (see FlockEvaluator::OnNewMail/
  // Iterate), so pre-deploy stationary-boat data no longer dilutes a run's
  // average -- but this still must not fire before every vehicle's pShare
  // has finished connecting to shoreside, or that vehicle's pShare bridge
  // misses the one-shot DEPLOY_ALL post entirely and that boat never
  // deploys for the rest of the run (pShare forwards *changes*, it does
  // not replay history to a link that connects late). With 10 vehicles
  // launched ~0.4s apart (see launch.sh) plus MOOSDB/pAntler startup, 15
  // real seconds of headroom is required; at MOOSTimeWarp=20 that is
  // time=300 in (warped) sim-time.
  event = time=300.0, var=DEPLOY_ALL, val=true
  event = time=300.0, var=RETURN_ALL, val=false
  event = time=300.0, var=MOOS_MANUAL_OVERRIDE_ALL, val=false
}

//------------------------------------------
// pFlockEvaluator config block
ProcessConfig = pFlockEvaluator
{
  AppTick   = 4
  CommsTick = 4

  // Tags every row this run writes so optimize.py can pull out exactly
  // this run's data from the (append-only, never-truncated-between-runs)
  // flock_evaluation.csv instead of trusting "last line of file".
  RUN_ID = $(RUN_ID)

  // Kept explicit at the old library default rather than switching to the
  // AGENT_DIAMETER-derived 2*radius overlap threshold -- this sim mission's
  // "boats" aren't modeled at real physical scale, so an explicit
  // OVERLAP_DISTANCE still wins over AGENT_DIAMETER here (see
  // FlockEvaluator.h's m_overlap_distance_explicit).
  OVERLAP_DISTANCE = 0.9

  // MaxClusterSize now uses Ward hierarchical clustering on a composite
  // position+heading distance (see FlockEvaluator::computeLargestCluster),
  // cut at CLUSTER_THRESHOLD (0.275 is ABM's tuned default; kept here since
  // the metric is normalized by the arena diagonal and thus scale-invariant).
  CLUSTER_THRESHOLD = 0.275

  // This mission wraps ownship across a 164m (2x82) torus via
  // uSimMarineV23 wormholes (see meta_vehicle.moos) -- without these,
  // MeanDistance/MaxClusterSize/OverlapRatio/AreaToCircleRatio all use
  // plain unwrapped Euclidean distance and spike/break for any pair
  // straddling a wormhole seam. ARENA_WIDTH must match the wormhole
  // spacing's full period (82*2), not the 82 half-width itself.
  // ARENA_WIDTH/ARENA_HEIGHT also set the arena-diagonal normalization used
  // by CLUSTER_THRESHOLD's distance metric, independent of TOROIDAL.
  TOROIDAL = true
  ARENA_WIDTH = 164.0
  ARENA_HEIGHT = 164.0
}
